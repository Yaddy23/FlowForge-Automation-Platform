# --- MongoDB -------------------------------------------------------------
# Any MongoDB works. Examples:
#   Local mongod:   mongodb://localhost:27017/flowforge
#   MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/flowforge?retryWrites=true&w=majority
#   Docker Compose: mongodb://flowforge:flowforge123@mongo:27017/flowforge
MONGODB_URI=mongodb://localhost:27017/flowforge

# --- Redis (optional) ----------------------------------------------------
# BullMQ queues. Leave REDIS_URL commented out to run without Redis: enqueueing
# becomes a no-op and runs stay `queued` unless RUN_POLLING_WORKER=true below.
# Required by the docker-compose stack, which runs a `redis` service.
# REDIS_URL=redis://localhost:6379

# Without Redis, set this to execute queued runs in-process instead of leaving
# them queued forever. Degraded mode: one run at a time per process, no retries,
# no cross-process coordination.
# RUN_POLLING_WORKER=true

# --- Secrets (generate fresh values for any real deployment) -------------
JWT_SECRET=your_jwt_secret_here_change_in_production
ACCESS_TOKEN_SECRET=your_access_token_secret_here_change_in_production
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here_change_in_production
CRED_ENCRYPTION_KEY=your_cred_encryption_key_here_change_in_production

PORT=3001
